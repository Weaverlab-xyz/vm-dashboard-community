# Copy to `.env` on each agent VM. Where the dashboard is reached the same way from every
# segment, the enrolment code is the only value that differs between hosts.

# The dashboard's AGENT vhost, not its UI vhost. If you split them (see
# ../../../docker-compose.agent.yml) the UI vhost does not serve the agent API at all,
# and an agent pointed at it gets a 404 that reads like a wrong path.
DASHBOARD_URL=https://agents.example.com

# From the Agents page → Register agent. Single-use, 15-minute expiry, and needed only on
# the first `docker compose up`. Blank it once the agent shows as online: after enrolment
# the Ed25519 key in the state volume is the credential, and a stale code in a file is
# just a thing to leak.
AGENT_ENROLLMENT_CODE=

# The gid of the Docker socket mounted in docker-compose.yml. Without it every Engine
# call gets EACCES and every Config-Management run fails at launch:
#   stat -c %g $XDG_RUNTIME_DIR/docker.sock
DOCKER_SOCKET_GID=

# Set to `audit` for a first pass: the agent leases jobs and logs exactly what it WOULD
# run, executing nothing. Useful for watching the CIDR routes land before any guest is
# actually reconfigured. Switch to `normal` (or delete the line) to arm it.
AGENT_MODE=normal
