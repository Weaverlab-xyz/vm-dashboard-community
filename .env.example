# ======================================================================
# Infrastructure Management Dashboard — Community Edition
#
# The onboard script (scripts/Onboard-Dashboard.ps1 or scripts/onboard.sh)
# copies this file to `.env` and auto-generates the secrets below.
#
# Cloud credentials (AWS, Azure) and feature flags are configured through
# the browser setup wizard on first launch — you do NOT need to fill them
# in here.
# ======================================================================


# === Bootstrap secrets (auto-generated by the onboard script) =========

# JWT_SECRET_KEY is NOT stored here. The onboard script generates a strong
# random value and writes it to .jwt_secret_key (owner-read-only, Docker
# secret mount). Keeping it out of .env means this file is safe to inspect
# for debugging without exposing the root-of-trust for encrypted secrets.
#
# Running without Docker Compose (e.g. bare uvicorn in CI)?
# Set JWT_SECRET_KEY=<hex> in the environment directly, or point
# JWT_SECRET_KEY_FILE at a file containing the key.

# PostgreSQL password for the Docker Compose `db` service.
# The onboard script generates a strong random value on first run.
POSTGRES_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD

# Environment name — leave as "development" for local Docker Desktop use.
APP_ENV=development


# === Optional: WebAuthn / FIDO2 MFA ====================================
#
# Leave at defaults for local dev (localhost is exempt from HTTPS).
# Change only when you expose the dashboard on a real domain.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Infrastructure Management Dashboard
WEBAUTHN_ORIGIN=http://localhost:8001


# === Optional: background job worker concurrency =====================
#
# Long jobs (k8s / cloud-DB provisions, Packer builds, image export &
# promote, VM deploys) run in the dedicated `worker` container, NOT the web
# app. ONE worker now runs SEVERAL at a time, capped by kind:
#
#   light  (3) start a cloud operation then poll its API — image exports,
#              promotes, copies, gateways, auto-delete sweeps. An export can
#              poll for two hours. Cheap; raise this first.
#   heavy  (2) terraform apply / Packer build. Each streams its output to the
#              database line by line, so two is usually enough to saturate a
#              small Postgres.
#   medium (1) cloud SDK plus a short terraform or kubectl/helm — VM deploys,
#              tunnels, Kubernetes add-ons.
#   total  (3) the overall ceiling, and the one that actually binds. The three
#              above may sum higher: they cap the MIX, this caps the TOTAL.
#
# These are only the bootstrap defaults. The normal way to change them is
# Settings → Job Worker, which stores them in the database and takes effect
# within ~5s with no restart — and shows you what the worker actually
# resolved them to, which is not always what you typed (see the pool below).
#
# Full reference, including deploying the worker as its own Azure Container App
# and the connection-budget arithmetic: docs/job-worker.md (also served in-app
# at /docs/job-worker).
#WORKER_HEAVY_CONCURRENCY=2
#WORKER_MEDIUM_CONCURRENCY=1
#WORKER_LIGHT_CONCURRENCY=3
#WORKER_MAX_CONCURRENCY=3

# Seconds to let running jobs finish when the worker is told to stop (a
# redeploy). Must stay UNDER your platform's termination grace period —
# 30s by default on Azure Container Apps — or the process is killed before
# it finishes waiting. Jobs longer than this are failed promptly by the next
# worker rather than looking alive for ten minutes. 0 = don't wait.
#WORKER_DRAIN_TIMEOUT_S=20

# Health endpoint for the worker, which has no other port -- without it a platform
# probe has nothing to target and a wedged runner looks identical to a healthy one.
# It answers 503 until the run loop is actually turning, so it catches a startup that
# never finishes; see docs/job-worker.md. Not published to the host by compose and the
# ACA app has no ingress, so it is reachable from the pod/host network only. 0 = off.
#WORKER_HEALTH_PORT=8080

# Compose only. WORKER_REPLICAS still MULTIPLIES the caps above (the queue
# claim is atomic, so replicas never double-execute a job): total concurrency
# is replicas × the caps. Prefer raising the caps over adding replicas —
# N slots in one process share ONE database connection pool, whereas N
# replicas need N pools, and the pool is usually the binding constraint.
# Ad-hoc override: docker compose up -d --scale worker=N
WORKER_REPLICAS=1
WORKER_CPU_LIMIT=2
WORKER_MEM_LIMIT=2g


# === Optional: database connection pool ==============================
#
# Per PROCESS: DB_POOL_SIZE + DB_MAX_OVERFLOW. The app runs `gunicorn -w 2`
# (two pools) and each worker one, so a single deployment holds
# 3 × (size + overflow) connections — 30 at the defaults below. Multiply by
# your replica count and keep the result under (max_connections - 20), the 20
# covering the server's own management and reserved sessions.
#
# Check the server first:   SHOW max_connections;
#
# This is what caps job concurrency in practice: a running job holds more than
# one connection, so the worker reduces WORKER_MAX_CONCURRENCY to what the pool
# can serve and reports it in Settings → Job Worker. Roughly, usable
# concurrency = (size + overflow - 4) / 2, so 5+5 supports 3.
#
# Azure Postgres Flexible Server Burstable B1ms allows only 50 connections,
# which is why these defaults are deliberately small; B2s and every General
# Purpose tier allow 429+ and can take much more. If the Settings readout says
# your total was reduced, raise these and redeploy.
#
# Cannot be set from the Settings page: the connection pool is built before the
# app can read anything out of the database.
#DB_POOL_SIZE=5
#DB_MAX_OVERFLOW=5


# === Optional: outbound notifications ================================
#
# Send auto-delete warnings, job failures and budget/secret/drift alerts to
# Slack, Microsoft Teams, or a signed JSON webhook. Configure this in the
# browser instead — Settings -> Notifications — where you also add the
# endpoints themselves (their URLs are credentials, so they are stored
# encrypted in the database, never here). See docs/notifications.md.
#
# The only value worth setting up front is the address operators reach the
# dashboard on: the worker has no request context, so without it every
# message ships with no link.
#NOTIFY_BASE_URL=https://dashboard.example.com

# ── Reverse proxy ─────────────────────────────────────────────────────────────
# Only relevant if something sits in front of the dashboard. Both unset is correct
# for the default compose, which publishes gunicorn directly.
#
# PUBLIC_BASE_URL is the origin the world reaches you on. Set it behind a proxy: the
# OAuth callback URIs and the remote-agent signing audience are built from it, and
# deriving them from the request instead makes them depend on the setting below.
#PUBLIC_BASE_URL=https://dashboard.example.com
#
# TRUSTED_PROXY_HOSTS lists the peers allowed to set X-Forwarded-For / -Proto.
# Defaults to 127.0.0.1 — a wildcard would let any client declare its own source
# address, which is what the login throttle's per-address cap keys off. Must be a
# LITERAL IP: uvicorn 0.27 compares strings, so a hostname or a CIDR never matches.
# If you get it wrong the app logs a warning naming the peer to add.
#TRUSTED_PROXY_HOSTS=172.29.7.2
